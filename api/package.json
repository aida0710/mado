{
  "name": "@mado/api",
  "private": true,
  "version": "1.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env internal.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/internal.js",
    "start:lineage": "node dist/lineage.js",
    "dev:lineage": "tsx watch --env-file=../.env lineage.ts",
    "lint": "eslint .",
    "test": "node --env-file-if-exists=../.env ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node --env-file-if-exists=../.env ./node_modules/vitest/vitest.mjs",
    "pricing:fetch": "tsx scripts/fetch-pricing.ts",
    "auth:bootstrap-admin": "node dist/scripts/bootstrap-admin.js",
    "auth:bootstrap-admin:dev": "tsx scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@hono/node-server": "^2.1.3",
    "argon2": "^0.45.1",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "lzma-native": "^8.0.6",
    "nanoid": "^5.0.0",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "tar-stream": "^3.2.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/pg": "^8.23.1",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  }
}
