PORT=3000
MADO_ENV=development

# Browser認証。外部公開時はdisabled禁止、HTTPSとAUTH_COOKIE_SECURE=trueを必須にする。
# local: 管理者が作成したLocal Userのみ（self-signupなし）
# oidc:  SSOのみ、hybrid: SSO + Local User
AUTH_MODE=local
AUTH_COOKIE_SECURE=false
AUTH_SESSION_IDLE_SECONDS=28800
AUTH_SESSION_ABSOLUTE_SECONDS=604800

# AUTH_MODE=oidc/hybridで必須。Authentik等のOIDC issuerを指定する。
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_LABEL=SSO
OIDC_SCOPES=openid email profile
# 未指定時はOIDC_REDIRECT_URIと同じoriginの / 。Authentik側にも登録する。
OIDC_POST_LOGOUT_REDIRECT_URI=
# email_verified=trueのときだけ同じemailのLocal UserへSSO identityを連携する。
OIDC_AUTO_LINK_VERIFIED_EMAIL=false
# OIDC利用時は必須。いずれかのgroup所属を必須にする。
OIDC_ALLOWED_GROUPS=mado-users,mado-admins,mado-curators,mado-operators
# Authentik group名 → Mado role。設定するとログインごとにroleを同期する。
OIDC_ROLE_MAPPING_JSON={"mado-admins":"admin","mado-curators":"curator","mado-operators":"operator","mado-users":"viewer"}
OIDC_DEFAULT_ROLE=viewer

# Dataset Registryが正本、Marquezは再構築可能なprojection。
# 同一hostのDockerからhost公開portへ接続する例。
DATASET_REGISTRY_URL=http://host.docker.internal:8088
DATASET_REGISTRY_TOKEN=
MARQUEZ_URL=http://host.docker.internal:5000
LINEAGE_API_PORT=3001
OPENLINEAGE_BODY_LIMIT_BYTES=2097152

# compose 内部 DNS で api コンテナ → postgres コンテナへ。host は `postgres` 固定。
DATABASE_URL_RW=postgres://dashboard_rw:CHANGEME@postgres:5432/dashboard
DATABASE_URL_RO=postgres://dashboard_ro:CHANGEME@postgres:5432/dashboard

# compose が postgres コンテナへ渡す DB 認証情報 (compose.{dev,prod}.yaml が参照)。
#  - prod(compose.prod.yaml): 未設定だと起動失敗。必ず強いパスワードを設定する必要がある。
#  - dev (compose.dev.yaml) : 未設定なら既定 (postgres / CHANGEME) で動く。
#  - DASHBOARD_PASSWORD は上の DATABASE_URL_RW / DATABASE_URL_RO のパスワードと必ず一致させる。
# ※ いずれも DB ボリュームの「初回作成時のみ」反映される。既存DBのパスワード変更は
#    psql の ALTER ROLE が必要 (env を変えるだけでは効かない)。生成例: openssl rand -hex 24
POSTGRES_PASSWORD=
DASHBOARD_PASSWORD=
# OpenLineage公開process専用DB role。英数字hexを推奨: openssl rand -hex 24
LINEAGE_DB_PASSWORD=

# テストは host 上で vitest を直接実行するため localhost を使う (compose は postgres を 127.0.0.1:5432 に publish 済み)。
# 未設定でも api/routes/*.test.ts のフォールバックで同じ default が使われる。
# パスワードは DASHBOARD_PASSWORD と必ず一致させること。ロールはその値で作られるため、
# ずれていると DB 依存テストが 100 件以上 "password authentication failed" で落ちる。
# 失敗が認証エラーなら DB は正常で、ここがずれているだけ (ボリュームの作り直しは不要)。
DATABASE_URL_RW_TEST=postgres://dashboard_rw:CHANGEME@localhost:5432/dashboard_test

# storage_connections の S3 認証情報を AES-256-GCM で暗号化するキー (32 byte hex, openssl rand -hex 32)
ENCRYPTION_KEY=

# ORIGIN ヘッダの値をスペース区切りで複数指定可能。例: http://localhost:5173 http://mado.internal
# 例: ALLOWED_ORIGINS=http://localhost:5173,http://mado.internal
ALLOWED_ORIGINS=http://localhost:5173

PREVIEW_TEXT_LIMIT=65536
PREVIEW_TAR_ENTRY_LIMIT=200
PREVIEW_TARXZ_BYTE_LIMIT=268435456
