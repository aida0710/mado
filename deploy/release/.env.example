# Browser/API runtime
PORT=3000
MADO_ENV=production
AUTH_MODE=local
AUTH_COOKIE_SECURE=true
AUTH_SESSION_IDLE_SECONDS=28800
AUTH_SESSION_ABSOLUTE_SECONDS=604800

# OIDC (AUTH_MODE=oidc/hybrid のとき必須)
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_LABEL=SSO
OIDC_SCOPES=openid email profile
OIDC_POST_LOGOUT_REDIRECT_URI=
OIDC_AUTO_LINK_VERIFIED_EMAIL=false
OIDC_ALLOWED_GROUPS=mado-users,mado-admins,mado-curators,mado-operators
OIDC_ROLE_MAPPING_JSON={"mado-admins":"admin","mado-curators":"curator","mado-operators":"operator","mado-users":"viewer"}
OIDC_DEFAULT_ROLE=viewer

# External lineage services
DATASET_REGISTRY_URL=
DATASET_REGISTRY_TOKEN=
MARQUEZ_URL=
LINEAGE_API_PORT=3001
OPENLINEAGE_BODY_LIMIT_BYTES=2097152

# PostgreSQL. DASHBOARD_PASSWORDとURL内のCHANGEMEを同じ強い値へ変更する。
POSTGRES_PASSWORD=
DASHBOARD_PASSWORD=
LINEAGE_DB_PASSWORD=
DATABASE_URL_RW=postgres://dashboard_rw:CHANGEME@postgres:5432/dashboard
DATABASE_URL_RO=postgres://dashboard_ro:CHANGEME@postgres:5432/dashboard

# 32-byte hex: openssl rand -hex 32
ENCRYPTION_KEY=

# TLS proxyからブラウザへ提示するorigin。カンマ区切りで複数指定可能。
ALLOWED_ORIGINS=https://mado.internal.example

PREVIEW_TEXT_LIMIT=65536
PREVIEW_TAR_ENTRY_LIMIT=200
PREVIEW_TARXZ_BYTE_LIMIT=268435456
